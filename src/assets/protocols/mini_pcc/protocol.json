{
  "title": "Development Protocol",
  "subtitle": "Developer testing of open-tabsint responseArea's.",
  "instructionText": "instructionText goes here",
  "hideProgressBar": true,
  "navMenu": [
    {
      "text": "Back to Main Menu",
      "target": {
        "reference": "MainMenu"
      },
      "returnHereAfterward": false
    }
  ],
  "pages": [
    {
      "protocolId": "MainMenu",
      "title": "Main Menu",
      "pages": [
        {
          "id": "choose",
          "title": "Response Area Testing",
          "questionMainText": "Please select a response area to test:",
          "responseArea": {
            "type": "multipleChoiceResponseArea",
            "choices": [
              {
                "id": "Text Box"
              },
              {
                "id": "LikeRT"
              },
              {
                "id": "Multiple Input"
              },
              {
                "id": "Yes/No"
              },
              {
                "id": "Integer"
              },
              {
                "id": "Subject ID"
              },
              {
                "id": "Checkbox"
              },
              {
                "id": "Image"
              },
              {
                "id": "Advanced Protocol Logic"
              },
              {
                "id": "Custom Response Area"
              },
              {
                "id": "End All"
              }
            ]
          },
          "followOns": [
            {
              "conditional": "result.response=='Text Box'",
              "target": {
                "reference": "TextBox"
              }
            },
            {
              "conditional": "result.response=='LikeRT'",
              "target": {
                "reference": "LikeRT"
              }
            },
            {
              "conditional": "result.response=='Multiple Input'",
              "target": {
                "reference": "MultipleInput"
              }
            },
            {
              "conditional": "result.response=='Yes/No'",
              "target": {
                "reference": "Yes/No"
              }
            },
            {
              "conditional": "result.response=='Integer'",
              "target": {
                "reference": "Integer"
              }
            },
            {
              "conditional": "result.response=='Subject ID'",
              "target": {
                "reference": "subjectId"
              }
            },
            {
              "conditional": "result.response=='Checkbox'",
              "target": {
                "reference": "checkbox"
              }
            },
            {
              "conditional": "result.response=='Image'",
              "target": {
                "reference": "image"
              }
            },
            {
              "conditional": "result.response=='Advanced Protocol Logic'",
              "target": {
                "reference": "advancedProtocolLogic"
              }
            },
            {
              "conditional": "result.response=='Custom Response Area'",
              "target": {
                "reference": "customResponseArea"
              }
            },
            {
              "conditional": "result.response=='End All'",
              "target": {
                "reference": "@END_ALL"
              }
            }
          ]
        }
      ]
    }
  ],
  "subProtocols": [
    {
      "protocolId": "TextBox",
      "pages": [
        {
          "id": "textbox_001",
          "title": "Text Box",
          "instructionText": "Page should always be submittable",
          "responseArea": {
            "type": "textboxResponseArea",
            "rows": 5,
            "responseRequired": false
          }
        },
        {
          "id": "textbox_002",
          "title": "Text Box",
          "instructionText": "Page should only be submittable when there is a response",
          "responseArea": {
            "type": "textboxResponseArea",
            "exportToCSV": true,
            "rows": 3,
            "responseRequired": true
          }
        },
        {
          "id": "textbox_003",
          "title": "Text Box",
          "instructionText": "Page should only be submittable when there is a response",
          "responseArea": {
            "type": "textboxResponseArea",
            "exportToCSV": true,
            "responseRequired": true
          }
        },
        {
          "id": "textbox_001_result_viewer",
          "title": "Text Box Result Viewer",
          "instructionText": "Page should always be submittable",
          "responseArea": {
            "type": "textboxResponseAreaResultViewer",
            "pageIdsToDisplay": ["textbox_001", "textbox_002", "textbox_003"]
          }
        },
        {
          "id": "backtomain",
          "reference": "MainMenu"
        }
      ]
    },
    {
      "protocolId": "LikeRT",
      "pages": [
        {
          "id": "default",
          "instructionText": "Page should only be submittable when there is a response",
          "responseArea": {
            "type": "likertResponseArea",
            "responseRequired": true,
            "levels": 5,
            "useEmoticons": true,
            "labels": ["Not at all", "Perfectly"],
            "questions": ["Question 1", "Question 2", "Question 3", "Question 4"]
          }
        },
        {
          "id": "default",
          "instructionText": "Page should only be submittable when there is a response",
          "responseArea": {
            "type": "likertResponseArea",
            "responseRequired": true,
            "levels": 5,
            "useSlider": true,
            "naBox": true,
            "labels": ["Not at all", "Perfectly"],
            "questions": ["Question 1", "Question 2"]
          }
        },
        {
          "id": "default",
          "instructionText": "Page should always be submittable",
          "responseArea": {
            "type": "likertResponseArea",
            "responseRequired": false,
            "levels": 5,
            "naBox": true,
            "labels": ["Not at all", "Perfectly"],
