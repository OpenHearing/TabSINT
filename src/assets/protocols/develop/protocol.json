    {
      "protocolId": "advancedProtocolLogic",
      "pages": [
        {
          "id": "advancedProtocolLogic_001",
          "title": "Page 1",
          "instructionText": "After submitting this page, it should skip the next one if you have entered text",
          "responseArea": {
            "type": "textboxResponseArea",
            "rows": 3,
            "responseRequired": false
          }
        },
        {
          "id": "advancedProtocolLogic_002",
          "title": "Page 2",
          "instructionText": "This page should have been skipped if you entered text in the previous page",
          "responseArea": {
            "type": "textboxResponseArea",
            "rows": 3,
            "responseRequired": false
          },
          "skipIf": "result.response.length > 0"
        },
        {
          "id": "advancedProtocolLogic_003",
          "title": "Page 3",
          "instructionText": "You are now on page 3",
          "responseArea": {
            "type": "textboxResponseArea",
            "rows": 3,
            "responseRequired": false
          }
        },
        {
          "id": "advancedProtocolLogic_004",
          "title": "Page 4",
          "instructionText": "This page is repeatable up to a maximum of three times",
          "responseArea": {
            "type": "multipleChoiceResponseArea",
            "choices": [
              {
                "id": "Repeat"
              },
              {
                "id": "Do not repeat"
              }
            ]
          },
          "repeatPage": {
            "nRepeats": 1,
            "repeatIf": "result.response==='Repeat'"
          }
        },
        {
          "id": "advancedProtocolLogic_005",
          "title": "Page 5",
          "instructionText": "This page can set testFlag",
          "responseArea": {
            "type": "multipleChoiceResponseArea",
            "choices": [
              {
                "id": "Set testFlag"
              },
              {
                "id": "Do not set testFlag"
