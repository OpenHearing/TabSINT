            "type": "textboxResponseArea",
            "rows": 5,
            "responseRequired": false
          }
        },
        {
          "id": "textbox_002",
          "title": "Text Box",
          "instructionText": "Page should only be submittable when there is a response",
          "responseArea": {
            "type": "textboxResponseArea",
            "exportToCSV": true,
            "rows": 3,
            "responseRequired": true
          }
        },
        {
          "id": "textbox_003",
          "title": "Text Box",
          "instructionText": "Page should only be submittable when there is a response",
