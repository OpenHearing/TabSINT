                "reference": "dosimetryResponseArea"
              }
            },
            {
              "conditional": "result.response=='Svantek'",
              "target": {
                "reference": "textBoxResponseAreaWithSvantek"
              }
            },
            {
              "conditional": "result.response=='Duodose Data Download'",
              "target": {
                "reference": "duodoseDownloadResponseArea"
              }
            },
            {
              "conditional": "result.response=='CHA Wav Test'",
              "target": {
                "reference": "PlayChaWavTest"
              }
            },
            {
              "conditional": "result.response=='Manual Audiometry'",
              "target": {
                "reference": "ManualAudiometry"
              }
            },
            {
              "conditional": "result.response=='Bekesy'",
              "target": {
                "reference": "bekesyResponseArea"
              }
            },
            {
              "conditional": "result.response=='Bekesy Like'",
              "target": {
                "reference": "bekesyLikeResponseArea"
              }
            },
            {
              "conditional": "result.response=='Hughson-Westlake Screener'",
              "target": {
                "reference": "hughsonWestlakeScreenerResponseArea"
              }
            },
            {
              "conditional": "result.response=='Hughson-Westlake Threshold'",
