            {
              "conditional": "result.response=='BHAFT'",
              "target": {
                "reference": "bhaftResponseArea"
              }
            },
            {
              "conditional": "result.response=='Three Digit Test'",
              "target": {
                "reference": "threeDigitResponseArea"
              }
            },
            {
              "conditional": "result.response=='MRT Exam'",
