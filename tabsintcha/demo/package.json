{
  "name": "demo",
  "version": "1.0.0",
  "description": "Demo Application",
  "type": "module",
  "keywords": [
    "capacitor",
    "mobile"
  ],
  "dependencies": {
    "@angular-devkit/build-angular": "^17.1.1",
    "@angular/cdk": "^17.1.0",
    "@angular/common": "^17.1.0",
    "@angular/compiler": "^17.1.0",
    "@angular/core": "^17.1.0",
    "@angular/cli": "^17.1.1",
    "@angular/compiler-cli": "^17.1.0",
    "@angular/localize": "^17.2.1",
    "@angular/platform-browser": "^17.1.0",
    "@angular/platform-browser-dynamic": "^17.1.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "tabsintcha": "file:.."
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0"
  },
  "scripts": {
    "ng": "ng",
    "clean": "rm -rf dist && rm -rf .angular/cache",
    "start": "ng serve",
    "build:plugin": "cd tabsintcha && rm -rf node_modules && npm i && npm run prepare --suffix dev && ng build && cd .. && npm i ./tabsintcha",
    "run.build": "ng build && npx cap sync android && cd android && ./gradlew assembleDebug && ./gradlew installDebug && cd ..",
    "run.android": "ng build && npx cap sync android && npx cap run android"
  },
  "author": "Creare LLC",
  "license": "Apache-2.0"
}
