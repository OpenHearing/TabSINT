{
  "name": "tabsint",
  "version": "5.0.0",
  "scripts": {
    "ng": "ng",
    "clean": "rm -rf dist && rm -rf .angular/cache",
    "start": "ng serve",
    "prepare": "ts-node --project ./bin/tsconfig.json ./bin/write-version.ts && ts-node --project ./bin/tsconfig.json ./bin/update-copyright-year.ts",
    "build:plugin.tabsintfs": "cd tabsintfs && rm -rf node_modules && npm i && npm run prepare && ng build && cd .. && npm i ./tabsintfs",
    "build:plugin.tabsintcha": "cd tabsintcha && rm -rf node_modules && npm i && npm run prepare && ng build && cd .. && npm i ./tabsintcha",
    "build:plugin.tabsintaudio": "cd tabsintaudio && rm -rf node_modules && npm i && npm run prepare && ng build && cd .. && npm i ./tabsintaudio",
    "build:plugins": "npm run build.plugin.tabsintfs && npm run build.plugin.tabsintcha && npm run build.plugin.tabsintaudio",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --code-coverage",
    "test:headless": "ng test --code-coverage --browsers=ChromeHeadlessNoSandbox --watch=false",
    "run.build": "npm run prepare --suffix dev && ng build && npx cap sync android && cd android && ./gradlew assembleDebug && cd ..",
    "run.build.beta:ci": "npm run prepare --suffix beta && ng build && npx cap sync android && cd android && ./gradlew assembleDebug && cd ..",
    "run.build.production:ci": "npm run prepare && ng build && npx cap sync android && cd android && ./gradlew assembleRelease && ./gradlew bundleRelease && cd ..",
    "run.android": "npm run prepare --suffix dev && ng build && npx cap sync android && npx cap run android",
    "serve:ssr:tabsint": "node dist/tabsint/server/server.mjs",
    "lint": "ng lint",
    "format": "prettier --write ."
  },
  "private": true,
  "dependencies": {
    "@angular-eslint/schematics": "^20.4.0",
    "@angular/animations": "^17.1.0",
    "@angular/cdk": "^17.1.0",
    "@angular/common": "^17.1.0",
    "@angular/compiler": "^17.1.0",
    "@angular/core": "^17.1.0",
    "@angular/forms": "^17.1.0",
    "@angular/material": "^17.2.0",
    "@angular/platform-browser": "^17.1.0",
    "@angular/platform-browser-dynamic": "^17.1.0",
    "@angular/platform-server": "^17.1.0",
    "@angular/router": "^17.1.0",
    "@angular/ssr": "^17.1.1",
    "@capacitor-community/bluetooth-le": "^8.0.0",
    "@capacitor-community/sqlite": "^8.0.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/angular": "^2.0.3",
    "@capacitor/app": "^8.0.0",
    "@capacitor/barcode-scanner": "^2.2.6",
    "@capacitor/core": "^8.0.0",
    "@capacitor/device": "^8.0.0",
    "@capacitor/file-transfer": "^2.0.4",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/network": "^8.0.0",
    "@capacitor/screen-orientation": "^8.0.0",
    "@jsverse/transloco": "^7.6.1",
    "@ng-bootstrap/ng-bootstrap": "^16.0.0",
    "@popperjs/core": "^2.11.8",
    "ajv": "^8.17.1",
    "angular-material-icons": "^0.7.1",
    "angularx-qrcode": "^17.0.1",
    "bootstrap": "^5.3.2",
    "bootstrap-icons": "^1.11.3",
    "buffer": "^6.0.3",
    "d3": "^7.9.0",
    "esbuild": "^0.24.2",
    "express": "^4.18.2",
    "ionicons": "^2.0.1",
    "jeep-sqlite": "2.7.2",
    "jsonformatter": "^0.7.0",
    "lodash": "^4.17.21",
    "material-icons-font": "^2.1.0",
    "ngx-csv-parser": "^2.0.0",
    "ngx-json-viewer": "^3.2.1",
    "papaparse": "^5.5.2",
    "rxjs": "~7.8.0",
    "simple-git": "^3.27.0",
    "tabsintaudio": "file:tabsintaudio",
    "tabsintcha": "file:tabsintcha",
    "tabsintfs": "file:tabsintfs",
    "tslib": "^2.3.0",
    "webpack-subresource-integrity": "^5.1.0",
    "xlsx": "^0.18.5",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.1.1",
    "@angular/cli": "^17.1.1",
    "@angular/compiler-cli": "^17.1.0",
    "@angular/localize": "^17.2.1",
    "@capacitor/cli": "^8.0.0",
    "@types/d3": "^7.4.3",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/lodash": "^4.14.202",
    "@types/node": "^18.18.0",
    "@types/papaparse": "^5.3.15",
    "angular-eslint": "20.4.0",
    "csv-parser": "^3.1.0",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier": "^3.0.0",
    "prettier-plugin-java": "^2.6.6",
    "ts-node": "^10.9.2",
    "typescript": "~5.3.2",
    "typescript-eslint": "8.46.0"
  }
}
